    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "patch-package": "8.0.1"
  },
  "build": {
    "appId": "io.github.dshdesktop.app",
    "productName": "DSH Desktop",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "DSH-Desktop-v${version}-macos-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 270,
          "y": 220,
          "type": "file",
          "path": "build/macos-install-notes.txt",
          "name": "安装说明.txt"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "DSH-Desktop-v${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DSH-Desktop-v${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "dsh-desktop",
      "maintainer": "DSH Desktop Contributors <liguobao@users.noreply.github.com>",
      "target": [
        "AppImage"
      ]
    },
    "appImage": {
      "artifactName": "DSH-Desktop-v${version}-linux-x64.${ext}"
    }
  },
